# ---------------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores reais.
#   cp .env.example .env
# Nunca suba o arquivo .env para o GitHub (ele já está no .gitignore).
# ---------------------------------------------------------------------------

# Conexão com o PostgreSQL.
# Local (Postgres instalado na sua máquina):
#   postgresql://USUARIO:SENHA@localhost:5432/biblioteca
# Nuvem (ex.: Neon) — copie a "connection string" do painel do provedor.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/biblioteca?schema=public"

# Segredo usado para assinar a sessão (cookie de login).
# Gere um valor aleatório forte, por exemplo rodando no terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-isto-por-um-valor-aleatorio-longo"
